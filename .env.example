# Development-only Docker Compose credentials.
# Copy to .env and replace every placeholder before starting services.
# Do not commit the real .env file.

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# These values are consumed by the Odoo process, not automatically
# injected into a separately running PyCharm/Windows Odoo process.
ODOO_SECURE_MINIO_ENDPOINT=127.0.0.1:9000
ODOO_SECURE_MINIO_ACCESS_KEY=minioadmin
ODOO_SECURE_MINIO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
ODOO_SECURE_MINIO_BUCKET=odoo-secure-documents
ODOO_SECURE_MINIO_TLS=false

ODOO_SECURE_STORAGE_ENABLED=0

# Base64 encoding of exactly 32 random bytes.
# Generate once for the environment, store in a secrets manager,
# and back it up securely. Never rotate casually: existing objects
# require the same key for decryption.
ODOO_SECURE_STORAGE_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Vault is used by the separate secure.document DEK-wrapping workflow.
ODOO_VAULT_ADDR=http://127.0.0.1:8200
ODOO_VAULT_TOKEN=REPLACE_WITH_LIMITED_POLICY_TOKEN
ODOO_VAULT_TRANSIT_KEY=odoo-documents
ODOO_VAULT_TRANSIT_MOUNT=transit
# Optional CA certificate path when Vault uses a private CA.
# ODOO_VAULT_CA_BUNDLE=/absolute/path/to/vault-ca.pem
