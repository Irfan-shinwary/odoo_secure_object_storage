# Development-only Docker Compose credentials.
# Copy this file to .env and replace every placeholder.
# Never commit the real .env file.

# MinIO root credentials are used only by the local development container.
# Create a separate least-privilege MinIO service account for Odoo.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Odoo process settings.
# These values are NOT automatically injected into a separately launched
# Windows/PyCharm Odoo process by Docker Compose. Configure the same values
# in the Odoo Run/Debug environment or load this file explicitly.
ODOO_SECURE_STORAGE_ENABLED=0
ODOO_SECURE_MINIO_ENDPOINT=127.0.0.1:9000
ODOO_SECURE_MINIO_ACCESS_KEY=REPLACE_WITH_ODOO_MINIO_ACCESS_KEY
ODOO_SECURE_MINIO_SECRET_KEY=REPLACE_WITH_ODOO_MINIO_SECRET_KEY
ODOO_SECURE_MINIO_BUCKET=odoo-secure-documents
ODOO_SECURE_MINIO_TLS=false

# Vault Transit is required for ir.attachment and secure.document encryption.
ODOO_VAULT_ADDR=http://127.0.0.1:8200
ODOO_VAULT_TOKEN=REPLACE_WITH_LIMITED_TRANSIT_TOKEN
ODOO_VAULT_TRANSIT_KEY=odoo-documents
ODOO_VAULT_TRANSIT_MOUNT=transit

# Optional: CA bundle path when Vault uses a private CA.
# ODOO_VAULT_CA_BUNDLE=/absolute/path/to/vault-ca.pem
