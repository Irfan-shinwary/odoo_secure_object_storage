
<odoo noupdate="1">

    <record id="ir_cron_secure_storage_auto_discovery"
            model="ir.cron">

        <field name="name">
            Secure Storage: Automatic Discovery
        </field>

        <field name="model_id"
               ref="model_secure_storage_migration"/>

        <field name="state">code</field>

        <field name="code">
            model.cron_auto_discover()
        </field>

        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>

    </record>


    <record id="ir_cron_secure_storage_auto_migration"
            model="ir.cron">

        <field name="name">
            Secure Storage: Automatic Migration
        </field>

        <field name="model_id"
               ref="model_secure_storage_migration"/>

        <field name="state">code</field>

        <field name="code">
            model.cron_auto_migrate()
        </field>

        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>

        <field name="active" eval="True"/>

    </record>

</odoo>
