
<odoo>

    <record id="view_secure_storage_config_form"
            model="ir.ui.view">

        <field name="name">secure.storage.config.form</field>
        <field name="model">secure.storage.config</field>

        <field name="arch" type="xml">
            <form string="Automatic Migration Configuration">

                <sheet>

                    <div class="oe_title">
                        <h1>Automatic Migration Configuration</h1>
                    </div>

                    <group>
                        <group string="Automation Control">
                            <field name="auto_migrate"/>
                        </group>
                    </group>

                    <group string="Processing Configuration"
                           invisible="not auto_migrate">

                        <group>
                            <field name="discovery_batch_size"/>
                            <field name="migration_batch_size"/>
                            <field name="retry_limit"/>
                        </group>

                        <group>
                            <field name="last_discovered_attachment_id"
                                   readonly="1"/>
                        </group>

                    </group>

                    <div class="alert alert-info" role="alert">
                        <strong>Automatic Migration:</strong>
                        When enabled, Odoo periodically discovers
                        legacy attachments and migrates eligible
                        records to encrypted MinIO storage.
                    </div>

                    <div class="alert alert-warning" role="alert">
                        Disabling automation stops future scheduled
                        discovery and migration executions. A transaction
                        already running may finish.
                    </div>

                </sheet>

            </form>
        </field>
    </record>


    <record id="action_secure_storage_config"
            model="ir.actions.act_window">

        <field name="name">Automatic Migration Configuration</field>
        <field name="res_model">secure.storage.config</field>
        <field name="view_mode">form</field>
        <field name="res_id"
               eval="ref('secure_storage_config_main')"/>
        <field name="target">current</field>

    </record>



     <!-- Automatic Migration Configuration -->
    <menuitem id="menu_secure_storage_config"
              name="Automatic Migration Configuration"
              parent="menu_secure_storage_configuration"
              action="action_secure_storage_config"
              sequence="1"
              groups="odoo_secure_object_storage.group_secure_storage_migration_manager,odoo_secure_object_storage.group_secure_document_manager"/>


</odoo>
